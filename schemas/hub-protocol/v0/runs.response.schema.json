{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kinged007/jigz/schemas/hub-protocol/v0/runs.response.schema.json",
  "title": "POST runs response",
  "type": "object",
  "additionalProperties": false,
  "required": ["accepted"],
  "properties": {
    "accepted": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1},
      "description": "Event ids the hub has stored, including ids it accepted before."
    }
  }
}
