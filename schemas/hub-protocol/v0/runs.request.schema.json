{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kinged007/jigz/schemas/hub-protocol/v0/runs.request.schema.json",
  "title": "POST runs request (run events batch)",
  "type": "object",
  "additionalProperties": false,
  "required": ["events"],
  "properties": {
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "workflow", "item", "attempt", "started_at"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 200, "description": "Unique per daemon."},
          "type": {"enum": ["started", "finished"]},
          "workflow": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"},
          "item": {
            "type": "object",
            "additionalProperties": false,
            "required": ["project", "number", "kind"],
            "properties": {
              "project": {"type": "string", "pattern": "^(?!\\.{1,2}/)(?!.*/\\.{1,2}$)[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
              "number": {"type": "integer", "minimum": 1},
              "kind": {"enum": ["issue", "pr"]}
            }
          },
          "attempt": {"type": "integer", "minimum": 1},
          "started_at": {"type": "string", "format": "date-time"},
          "finished_at": {"type": "string", "format": "date-time"},
          "outcome": {"enum": ["succeeded", "failed_agent", "failed_workspace", "failed_limit", "cancelled", "timeout", "handoff_withheld"]},
          "usage": {
            "type": "object",
            "additionalProperties": false,
            "required": ["input_tokens", "output_tokens", "total_tokens", "measured"],
            "properties": {
              "input_tokens": {"type": "integer", "minimum": 0},
              "output_tokens": {"type": "integer", "minimum": 0},
              "total_tokens": {"type": "integer", "minimum": 0},
              "measured": {"type": "boolean", "description": "Whether the agent reported the counts."},
              "cost_usd": {"type": "number", "minimum": 0}
            }
          },
          "links": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "branch": {"type": "string", "minLength": 1},
              "pr": {"type": "string", "format": "uri"},
              "comment": {"type": "string", "format": "uri"}
            }
          }
        },
        "if": {"properties": {"type": {"const": "finished"}}},
        "then": {"required": ["finished_at", "outcome", "usage"]},
        "else": {"not": {"anyOf": [{"required": ["finished_at"]}, {"required": ["outcome"]}, {"required": ["usage"]}]}}
      }
    }
  }
}
